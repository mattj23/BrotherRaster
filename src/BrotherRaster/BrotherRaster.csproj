<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>BrotherRaster</RootNamespace>
    <Description>Drive Brother QL and P-touch (PT) label printers over the network: raster encoders for both families, a raw TCP transport that waits for the printer to take the whole job, SNMP status (including Brother's 32-byte status block) and a dispatcher that never sends a job twice. No dependencies.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BrotherRaster.Tests" />
  </ItemGroup>

</Project>
